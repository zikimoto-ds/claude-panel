# Plantilla: copia a .env.local (no se sube a git) y ajusta.
PANEL_HOST=0.0.0.0
PANEL_PORT=8765
# Token largo y aleatorio; el mismo va en firmware/include/secrets.h
PANEL_TOKEN=cambia-esto
# Opcional: token aparte para el Atajo de Siri por el túnel (solo crea sesiones)
# PANEL_TOKEN_SIRI=
# Topes de tokens para los medidores (calíbralos contra claude.ai → Usage)
PANEL_LIMITE_SESION=15600000
PANEL_LIMITE_SEMANA=52000000
# Reinicio semanal: día (0 = lunes) y hora
PANEL_RESET_SEMANAL=2 21:00
# Inicio de un bloque de 5 h conocido (hora de reinicio en Usage − 5 h)
# PANEL_ANCLA_BLOQUE=2026-01-01 14:40
